{
  "expo": {
    "name": "Colordoku",
    "slug": "colordoku",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "colordoku",
    "userInterfaceStyle": "dark",
    "androidStatusBar": {
      "backgroundColor": "#09090b",
      "barStyle": "light-content"
    },
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.bercanayd.colordoku"
    },
    "android": {
      "package": "com.bercanayd.colordoku",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#18181b",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "com.google.android.gms.permission.AD_ID",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#202024",
          "android": {
            "image": "./assets/images/icon (1).png",
            "imageWidth": 150
          }
        }
      ],
      [
        "expo-navigation-bar",
        {
          "backgroundColor": "#000000",
          "style": "dark"
        }
      ],
     [
      "react-native-google-mobile-ads",
      {
        "androidAppId": "ca-app-pub-7345089833984227~2159323692",
        "iosAppId": "ca-app-pub-7345089833984227~2159323692"
      }
    ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.google.android.gms.** { *; }",
            "enableMinifyInReleaseBuilds": true,
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "038213d2-8911-4856-8542-d418e332d078"
      }
    }
  }
}
